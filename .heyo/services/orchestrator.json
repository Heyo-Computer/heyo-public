{
    "id": "orchestrator",
    "user_id": "heyo-system",
    "account_id": "heyo-system",
    "vm": {
        "driver": "libvirt",
        "image": "ubuntu:24.04",
        "port": 8080,
        "start_command": "i=0; until mountpoint -q /workspace && [ -x /workspace/start.sh ]; do sudo -n modprobe 9p 2>/dev/null || true; sudo -n modprobe 9pnet 2>/dev/null || true; sudo -n modprobe 9pnet_virtio 2>/dev/null || true; sudo -n mount -a 2>/dev/null || true; i=$((i + 1)); if [ \"$i\" -ge 300 ]; then echo \"workspace mount did not become ready within 300 seconds\" >&2; exit 1; fi; sleep 1; done; cd /workspace; exec ./start.sh",
        "working_directory": "/",
        "size_class": "small",
        "ttl_seconds": 0,
        "env_vars": {
            "ORCHESTRATOR_SERVER_PORT": "8080",
            "ORCHESTRATOR_MIGRATIONS_DIR": "/workspace/migrations",
            "ORCHESTRATOR_TRAEFIK_DYNAMIC_CONFIG_DIR": "/opt/heyo-deploy/orchestrator/traefik-dynamic.d",
            "ORCHESTRATOR_SERVICE_STATE_DIR": "/opt/heyo-deploy/orchestrator/service-state",
            "ORCHESTRATOR_REPOSITORY_CLONE_ROOT": "/workspace/repos"
        },
        "env_from": [
            {
                "secret": "orchestrator",
                "key": "database-url",
                "as": "DATABASE_URL"
            },
            {
                "secret": "orchestrator",
                "key": "database-url",
                "as": "ORCHESTRATOR_DATABASE_URL"
            },
            {
                "secret": "orchestrator",
                "key": "jwt-secret",
                "as": "JWT_SECRET"
            },
            {
                "secret": "orchestrator",
                "key": "jwt-secret",
                "as": "ORCHESTRATOR_JWT_SECRET"
            },
            {
                "secret": "orchestrator",
                "key": "internal-api-key",
                "as": "ORCHESTRATOR_INTERNAL_API_KEY"
            },
            {
                "secret": "orchestrator",
                "key": "internal-api-key",
                "as": "HEYOSECRET_INTERNAL_API_KEY"
            },
            {
                "secret": "orchestrator",
                "key": "internal-api-key",
                "as": "ORCHESTRATOR_HEYOSECRET_INTERNAL_API_KEY"
            },
            {
                "secret": "cloud",
                "key": "internal-api-key",
                "as": "CLOUD_INTERNAL_API_KEY"
            }
        ]
    },
    "routes": [],
    "health": {
        "path": "/health",
        "timeout_secs": 5
    },
    "deploy": {
        "name": "heyo-orchestrator",
        "async": true,
        "region": "EU",
        "health_timeout_seconds": 900,
        "drain_seconds": 30,
        "retire_previous": true,
        "retire_previous_async": true,
        "delete_previous": true
    }
}
