[package]
name = "heyo-sdk"
version = "0.1.12"
edition = "2021"
description = "Rust SDK for the Heyo cloud sandbox API."
license = "Apache-2.0"
homepage = "https://heyo.computer"
readme = "README.md"
repository = "https://docs.heyo.computer"
# This test stands up the proxy *server* via the path-only `hey-proxy`
# dev-dependency, which is stripped from the published crate. Exclude it so a
# downstream `cargo test` of the published package doesn't fail to compile.
exclude = ["tests/p2p_roundtrip.rs"]

[dependencies]
reqwest = { version = "0.12", default-features = false, features = ["json", "rustls-tls", "stream"] }
tokio = { version = "1", features = ["macros", "rt-multi-thread", "sync", "time", "net", "io-util"] }
tokio-tungstenite = { version = "0.23", default-features = false, features = ["connect", "rustls-tls-webpki-roots"] }
futures-util = "0.3"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
base64 = "0.22"
flate2 = "1"
thiserror = "1"
url = "2"
bytes = "1"
tokio-util = { version = "0.7", features = ["io"] }
http = "1"
# Already in the graph via iroh; direct so the tunnel can explain its own
# failures instead of discarding them. Facade only — the consumer picks a
# subscriber, and with none installed these calls compile to nothing.
tracing = "0.1"
async-stream = "0.3"
# Direct iroh P2P tunnel to a remote heyvm daemon / shared sandbox
# (HeyoClient::connect_p2p, P2pTunnel). The client-side proxy is inlined in
# src/proxy.rs so the SDK is self-contained — no path dependency.
iroh = "1"
iroh-tickets = "1"
anyhow = "1"
# Resolution pin (not used directly). iroh 1.x pulls the pre-release RustCrypto
# stack via ed25519-dalek 3.0.0-rc → curve25519-dalek → digest 0.11.3. That
# `digest` is incompatible with the released `crypto-common 0.2.0` (a sealed
# `BlockSizes`/typenum trait bound fails to compile); 0.2.1+ fixes it. Pin the
# floor so a fresh consumer of this published crate resolves a buildable graph.
# Drop once iroh moves to a stable (non-rc) ed25519/digest line.
crypto-common = "0.2.2"

# Unix-socket transport (`HeyoClient::local_socket` / `local_auto`). All of
# these are already in the tree transitively via reqwest; declaring them only
# surfaces hyper-util's legacy client API. Unix-only because unix sockets are.
[target.'cfg(unix)'.dependencies]
hyper = { version = "1", features = ["client", "http1"] }
hyper-util = { version = "0.1", features = ["client-legacy", "http1", "tokio"] }
http-body-util = "0.1"
tower-service = "0.3"

[dev-dependencies]
tokio = { version = "1", features = ["macros", "rt-multi-thread", "sync", "time", "net", "fs", "io-util"] }
# Server side of the proxy, used only by tests/p2p_roundtrip.rs to stand up a
# peer. Path-only dev-dependency → stripped from the published manifest.
hey-proxy = { path = "../local-proxy" }
