{
  "id": "ci",
  "routes": [
    { "host": "ci.us2.heyo.work" }
  ],
  "upstreams": ["127.0.0.1:9500"],
  "health": { "path": "/healthz", "timeout_secs": 2 },

  "update": {
    "working_dir": "/home/sarocu/Projects",
    "commands": [
      "test -d heyo-public/.git || git clone https://github.com/Heyo-Computer/heyo-public.git heyo-public",
      "git -C heyo-public pull --ff-only",
      "cargo build --release --locked --manifest-path heyo-public/ci/Cargo.toml",
      "install -m 0755 heyo-public/ci/target/release/ci /usr/local/bin/ci",
      "install -d -m 0755 /var/lib/ci/migrations",
      "install -m 0644 heyo-public/ci/migrations/*.sql /var/lib/ci/migrations/",
      "supervisorctl restart ci"
    ],
    "env": { "CARGO_TERM_COLOR": "never" },
    "timeout_secs": 1800,
    "verify_timeout_secs": 60
  },

  "auth": {
    "provider": ["google", "app-token"],
    "client_id": "REPLACE-ME.apps.googleusercontent.com",
    "client_secret": { "secret": "google", "key": "client_secret" },
    "allowed_domains": ["heyo.computer", "sarocu.com"],
    "public_paths": ["/healthz", "/api/submit", "/api/stream/", "/__ui/"],
    "base_path": "/__applb/auth",
    "cookie_domain": "us2.heyo.work",
    "session_ttl_secs": 43200,
    "forward_identity": true
  }
}
