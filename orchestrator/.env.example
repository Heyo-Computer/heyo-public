# Orchestrator configuration — copy to `.env` and fill in real values.
# The orchestrator loads this file via dotenvy at startup (main.rs:28).
# `.env` is gitignored; `.env.example` is committed.

# --- Server ---
ORCHESTRATOR_SERVER_PORT=4446
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/orchestrator_db
# Conservative per-process pool. This cap is multiplied by the number of
# replicas and shares Postgres `max_connections` with auth/cloud — raise only
# if the Postgres server has the spare capacity.
ORCHESTRATOR_DB_MAX_CONNECTIONS=20
ORCHESTRATOR_DB_MIN_CONNECTIONS=2
ORCHESTRATOR_DB_CONNECT_TIMEOUT_SECONDS=8
ORCHESTRATOR_DB_ACQUIRE_TIMEOUT_SECONDS=30
ORCHESTRATOR_DB_IDLE_TIMEOUT_SECONDS=600
ORCHESTRATOR_DB_MAX_LIFETIME_SECONDS=1800
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
CLOUD_INTERNAL_API_KEY=your-internal-api-key-change-this
ORCHESTRATOR_CLOUD_INTERNAL_URL=http://127.0.0.1:4445
# Comma-separated domains used to recognize backend wildcard proxy URLs.
# ORCHESTRATOR_PROXY_BASE_DOMAINS=stage.example.com,example.com
RUST_LOG=info

# --- Agent: global provider + model ---
# Default: Anthropic + Opus 4.7 (Amp-equivalent heavy tier).
# Change ORCHESTRATOR_AGENT_PROVIDER to `openai`, `mistral`, or `gemini` to
# swap the primary. ORCHESTRATOR_AGENT_MODEL overrides the provider's
# flagship default (claude-opus-4-7 / gpt-5.3-codex / mistral-large-latest /
# gemini-1.5-pro).
ORCHESTRATOR_AGENT_PROVIDER=anthropic
ORCHESTRATOR_AGENT_MODEL=claude-opus-4-7

# --- Agent: per-phase overrides (optional) ---
# Phases: discovery, planning, review, patch.
# Both PROVIDER_<PHASE> and MODEL_<PHASE> must be set together for the
# override to apply — a half-configured phase falls back to the global pair
# so we don't accidentally send a Mistral model to Anthropic's API.
#
# Shipped defaults route `discovery` to Mistral (cheap repo scan) and leave
# planning/review/patch on the global Anthropic Opus. Uncomment and edit to
# point a phase at OpenAI Codex instead.
ORCHESTRATOR_AGENT_PROVIDER_DISCOVERY=mistral
ORCHESTRATOR_AGENT_MODEL_DISCOVERY=mistral-large-latest
# ORCHESTRATOR_AGENT_PROVIDER_PATCH=openai
# ORCHESTRATOR_AGENT_MODEL_PATCH=gpt-5.3-codex

# --- Agent: limits ---
ORCHESTRATOR_AGENT_TIMEOUT_SECONDS=900
ORCHESTRATOR_AGENT_MAX_ITERATIONS=15

# --- Provider API keys ---
# ORCHESTRATOR_AGENT_API_KEY is used for the *global* provider only (the one
# set by ORCHESTRATOR_AGENT_PROVIDER). Per-phase overrides that switch
# providers must use the provider-specific env vars below — the global
# agent_api_key will NOT be reused for them.
ORCHESTRATOR_AGENT_API_KEY=

# Provider-specific fallbacks. Also used by any phase override that points
# at a non-global provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
# GOOGLE_API_KEY=
