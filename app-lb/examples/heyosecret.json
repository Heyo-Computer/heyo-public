{
  "id": "heyosecret",
  "routes": [
    { "host": "sec1.us2.heyo.work" }
  ],
  "vm": {
    "driver": "firecracker",
    "image": "secrets",
    "port": 4455,
    "start_command": "cd /opt/heyosecret && setsid nohup /usr/local/bin/heyosecret </dev/null >/var/log/heyosecret.log 2>&1 &",
    "size_class": "mini",
    "env_vars": {
      "HEYOSECRET_DATABASE_URL": "postgres://postgres:ael2waabe2ishoK2lahKeagh@us2.heyo.work:6432/pg-appsecrets",
      "HEYOSECRET_INTERNAL_API_KEY": "CHANGE_ME",
      "HEYOSECRET_MASTER_KEY": "CHANGE_ME_AT_LEAST_32_BYTES_LONG_0000",
      "HEYOSECRET_ADMIN_PASSWORD": "CHANGE_ME",
      "HEYOSECRET_MIGRATIONS_DIR": "/opt/heyosecret/migrations",
      "HEYOSECRET_SERVER_PORT": "4455",
      "HEYOSECRET_COOKIE_SECURE": "false",
      "RUST_LOG": "info"
    },
    "ttl_seconds": 3600
  },
  "scaling": {
    "min_replicas": 1,
    "max_replicas": 2,
    "warm_pool": 0,
    "target_concurrency": 32,
    "scale_to_zero_after_secs": 300,
    "cold_start_timeout_secs": 120,
    "drain_timeout_secs": 30
  },
  "health": {
    "path": "/health",
    "timeout_secs": 2
  }
}
