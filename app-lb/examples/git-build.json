{
  "id": "web",
  "routes": [
    { "host": "web.us2.heyo.work" }
  ],
  "vm": {
    "driver": "firecracker",
    "image": "web",
    "port": 8080,
    "start_command": "cd /opt/web && setsid nohup /usr/local/bin/web </dev/null >/var/log/web.log 2>&1 &",
    "size_class": "mini",
    "env_vars": {
      "RUST_LOG": "info"
    },
    "ttl_seconds": 3600
  },
  "build": {
    "repo": "https://github.com/acme/web.git",
    "ref": "main",
    "dockerfile": "Dockerfile",
    "image_size_mb": 768,
    "auth": { "secret": "github", "key": "token" }
  },
  "scaling": {
    "min_replicas": 1,
    "max_replicas": 4,
    "warm_pool": 0,
    "target_concurrency": 16,
    "scale_to_zero_after_secs": 300,
    "cold_start_timeout_secs": 120,
    "drain_timeout_secs": 30
  },
  "health": {
    "path": "/health",
    "timeout_secs": 2
  }
}
