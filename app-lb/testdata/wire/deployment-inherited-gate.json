{
  "id": "team-a-app",
  "namespace": "team-a",
  "routes": [
    {
      "host": "sandbox.example.com"
    },
    {
      "host_suffix": "sb.example.com",
      "path_prefix": "/api"
    }
  ],
  "vm": {
    "driver": "firecracker",
    "image": "agent-base",
    "port": 8080,
    "start_command": "/usr/local/bin/agent serve",
    "size_class": "medium",
    "disk_size_gb": 20,
    "working_directory": "/workspace",
    "env_vars": {
      "RUST_LOG": "info"
    },
    "setup_hooks": [
      "apt-get update"
    ],
    "open_ports": [
      9229
    ],
    "mounts": [
      {
        "path": "/data/corpus",
        "store": "http://127.0.0.1:8080",
        "ref": "corpus-2026-08",
        "auth": {
          "secret": "art-key",
          "key": "token"
        },
        "strip_components": 1,
        "read_only": true,
        "digest": "0f1e2d3c4b5a69788796a5b4c3d2e1f00f1e2d3c4b5a69788796a5b4c3d2e1f0"
      }
    ],
    "ttl_seconds": 86400
  },
  "scaling": {
    "min_replicas": 0,
    "max_replicas": 1,
    "warm_pool": 0,
    "target_concurrency": 1,
    "scale_to_zero_after_secs": 900,
    "cold_start_timeout_secs": 120,
    "drain_timeout_secs": 30,
    "boot_timeout_secs": 300,
    "idle_action": "retain"
  },
  "health": {
    "path": "/healthz",
    "port": 8080,
    "timeout_secs": 2
  },
  "build": {
    "repo": "https://github.com/example/agent",
    "ref": "main",
    "dockerfile": "Dockerfile",
    "context": ".",
    "image_name": "agent-base",
    "image_size_mb": 4096,
    "auth": {
      "secret": "github",
      "key": "token",
      "username": "git"
    }
  },
  "auth": {
    "provider": "google",
    "public_paths": [
      {
        "path": "/healthz",
        "scope": "public"
      }
    ],
    "base_path": "/__applb/auth",
    "session_ttl_secs": 43200,
    "cookie_name": "applb_session",
    "forward_identity": true,
    "provider_ref": "corp-google"
  }
}
