{
  "spec": {
    "id": "sandbox-pull",
    "routes": [
      {
        "host": "sandbox.example.com"
      },
      {
        "host_suffix": "sb.example.com",
        "path_prefix": "/api"
      }
    ],
    "vm": {
      "driver": "firecracker",
      "image": "agent-base",
      "port": 8080,
      "start_command": "/usr/local/bin/agent serve",
      "size_class": "medium",
      "disk_size_gb": 20,
      "working_directory": "/workspace",
      "env_vars": {
        "RUST_LOG": "info"
      },
      "setup_hooks": [
        "apt-get update"
      ],
      "open_ports": [
        9229
      ],
      "ttl_seconds": 86400
    },
    "scaling": {
      "min_replicas": 0,
      "max_replicas": 1,
      "warm_pool": 0,
      "target_concurrency": 1,
      "scale_to_zero_after_secs": 900,
      "cold_start_timeout_secs": 120,
      "drain_timeout_secs": 30,
      "boot_timeout_secs": 300,
      "idle_action": "retain"
    },
    "health": {
      "path": "/healthz",
      "port": 8080,
      "timeout_secs": 2
    },
    "artifact": {
      "store": "http://127.0.0.1:8080",
      "ref": "agent-base",
      "auth": {
        "secret": "art",
        "key": "api_key"
      },
      "grow_gb": 8,
      "image_name": "agent-base"
    }
  },
  "kind": "vm",
  "desired_replicas": 1,
  "ready": 1,
  "pending": 1,
  "total_in_flight": 3,
  "vms": [
    {
      "sandbox_id": "applb-sandbox-a1b2c3",
      "addr": "172.16.0.4:8080",
      "in_flight": 3,
      "healthy": true,
      "draining": false
    }
  ]
}
